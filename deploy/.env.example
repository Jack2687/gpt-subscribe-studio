# ============================================================================
# 直卡协议 —— 环境变量示例
# 复制为 .env 后修改。**不要把真实 .env 提交到 Git。**
# ============================================================================

# ---- 绑定（默认仅回环，公网暴露须经反代 + 鉴权）----
DCP_BIND_HOST=127.0.0.1
DCP_BIND_PORT=8080
DCP_DATA_DIR=/data
DCP_CONFIG_DIR=/config

# ---- 高风险模式：默认关闭（宪法第 IV 条）----
# 开启后仍需在订单上显式 risk_acknowledged=true。
DCP_ENABLE_PROMO=false

# ---- 上游引用（见 docs/upstream-integration.md）----
# 二选一：submodule 或本地路径。
UPSTREAM_GPT_REGISTER_TOOL_PATH=/opt/upstream/GPT-Register-Tool
UPSTREAM_ZKKY_PATH=/opt/upstream/zkky

# ---- 应急覆盖：上游轮换 key / SDK 版本时使用，无需改代码 ----
# PP_STRIPE_PUBLISHABLE_KEY=
# OPENAI_SENTINEL_VERSION=
# OPENAI_SENTINEL_DISABLE_QUICKJS=

# ---- 代理池（占位；真实值只留在本机）----
# 提链池与支付池必须独立，互不覆盖。
# CHECKOUT_PROXY_POOL=http://user:pass@gateway-a:port
# APPROVE_PROXY_POOL=http://user:pass@gateway-b:port
# MAILBOX_PROXY=http://127.0.0.1:7897
