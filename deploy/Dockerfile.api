# gpt-subscribe-studio —— API / worker 运行镜像
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/packages/contracts/src:/app/packages/core/src:/app/services/api/src:/app/services/orchestrator/src:/app/services/checkout/src:/app/services/payment/src:/app/services/account/src

WORKDIR /app

# 先装依赖，利用层缓存
RUN pip install --no-cache-dir \
        "fastapi>=0.115" \
        "uvicorn[standard]>=0.30" \
        "pydantic>=2.7"

# 复制项目（骨架阶段直接挂 PYTHONPATH；正式版应 pip install 各包）
COPY pyproject.toml /app/pyproject.toml
COPY packages /app/packages
COPY services /app/services
COPY scripts /app/scripts

# 以非 root 运行
RUN useradd --create-home --uid 10001 dcp && mkdir -p /data /config && chown -R dcp:dcp /data /config
USER dcp

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=3).status==200 else 1)"

CMD ["uvicorn", "dcp_api.main:app", "--host", "0.0.0.0", "--port", "8080"]
